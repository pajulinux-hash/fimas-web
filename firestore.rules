rules_version = '2';
// Pravidla databáze Firestore pro e-shop adrparts.cz (projekt adr-fimas)
// Vložit do: Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrátor = jen pajulinux@gmail.com s OVĚŘENÝM e-mailem
    // (stejná adresa je v index.html v konstantě ADMIN_EMAILS)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'pajulinux@gmail.com';
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profily zákazníků: zákazník čte a mění jen svůj profil, admin čte všechny
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.size() < 40;
      allow delete: if isAdmin();
    }

    // Objednávky: vytvořit může kdokoli (i bez registrace), číst jen vlastník nebo admin
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'date', 'items', 'total'])
                    && request.resource.data.id == orderId
                    && (!('uid' in request.resource.data) || isOwner(request.resource.data.uid));
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Odstoupení od smlouvy: odeslat může kdokoli, číst jen admin
    match /withdrawals/{id} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'email', 'items']);
      allow read, update, delete: if isAdmin();
    }

    // Nastavení webu (žlutý pruh s oznámením): číst může každý, měnit jen admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Počítadlo přístupů: každý smí jen přičíst +1 (visits/visitors/views), číst jen admin
    match /visits/{day} {
      allow read, delete: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['visits', 'visitors', 'views'])
                    && request.resource.data.get('views', 0) <= 1
                    && request.resource.data.get('visits', 0) <= 1
                    && request.resource.data.get('visitors', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['visits', 'visitors', 'views'])
                    && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
                    && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
                    && request.resource.data.get('visits', 0) >= resource.data.get('visits', 0)
                    && request.resource.data.get('visits', 0) <= resource.data.get('visits', 0) + 1
                    && request.resource.data.get('visitors', 0) >= resource.data.get('visitors', 0)
                    && request.resource.data.get('visitors', 0) <= resource.data.get('visitors', 0) + 1;
    }

    // Vše ostatní zakázáno
    // Cenové nabídky – jen admin (číst, vytvářet, upravovat, mazat)
    match /offers/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
